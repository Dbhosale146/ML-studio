# ---- LLM -------------------------------------------------------------------------------
# mock  = rules + templates, works offline with no key (default)
# gemini = Google Gemini via the google-genai SDK (needs GEMINI_API_KEY)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- App -------------------------------------------------------------------------------
# Name the agent uses to greet the user
DISPLAY_NAME=there
# Where uploads, model artifacts, the SQLite DB and MLflow runs are stored (relative to services/api)
STORAGE_DIR=../../storage
LOG_LEVEL=INFO

# ---- Limits ----------------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_ROWS=500000
MAX_COLUMNS=300
# Total model-search budget per run, in seconds
TRAIN_TIME_BUDGET_S=300
RANDOM_STATE=42
MLFLOW_ENABLED=true
