          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets": {
      "post": {
        "tags": [
          "datasets"
        ],
        "summary": "Upload an Excel or CSV file",
        "operationId": "upload_dataset_api_v1_datasets_post",
